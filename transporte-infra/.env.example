# =====================================================================
# Copiar a .env (NUNCA subir el .env al repo).
#   · En mv-bd lo usa docker-compose.bd.yml (crea las 3 bases y sus usuarios).
#   · En mv-prod-a / mv-prod-b lo usa docker-compose.prod.yml.
# IMPORTANTE: usar la MISMA clave para los 3 usuarios de aplicación
# (app_ms1, app_ms2, app_ms3): la ingesta de datos usa una sola clave (BD_PASS).
# =====================================================================

# Claves de los usuarios de aplicación (misma clave en las 3)
POSTGRES_PASS=
MYSQL_PASS=
MONGO_APP_PASS=

# Claves de administrador (solo mv-bd)
MYSQL_ROOT_PASS=
MONGO_ROOT_PASS=

# --- Solo para mv-prod-a / mv-prod-b -----------------------------------
# IP privada de mv-bd  (terraform output ip_privada_mv_bd)
BD_HOST=10.0.2.x
# Bucket del data lake (MS5 guarda ahí los resultados de Athena)
S3_BUCKET=transporte-datalake-xxxx
# URL del API Gateway, sin barra final (solo afecta al botón "Try it out" de Swagger)
API_GATEWAY_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
