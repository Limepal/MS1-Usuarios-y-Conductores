# --- conexión a PostgreSQL en mv-bd --------------------------------------------------
# BD_HOST es la IP privada de la instancia mv-bd (subred privada 10.0.2.0/24).
BD_HOST=10.0.2.10

# POSTGRES_URL suele venir interpolada con ${POSTGRES_PASS} según el contrato.
POSTGRES_URL=postgresql://app_ms1:${POSTGRES_PASS}@${BD_HOST}:5432/usuarios_db
POSTGRES_PASS=

# --- para Swagger servers[] cuando se despliegue detrás del API Gateway ---------------
API_GATEWAY_URL=

# --- puerto local (informativo, en Docker se mapea a 8001) ----------------------------
PORT=8001
